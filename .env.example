# Path ke file Excel reminder (wajib)
EXCEL_FILE_PATH=./data/reminder.xlsx

# true membuka Chrome secara visual; pada Windows default-nya true bila tidak diatur
# Set false untuk menjalankan Chrome headless
# DEBUG_HEADLESS=

# Timeout komunikasi Puppeteer (ms)
PROTOCOL_TIMEOUT_MS=600000

# Delay antar grup (ms), dengan jitter acak +/- 1000 ms
SEND_DELAY_MS=3000

# Jeda retry untuk error pengiriman sementara (ms); maksimal 2 retry
SEND_RETRY_DELAY_MS=5000

# Uji tanpa mengirim pesan sungguhan
DRY_RUN=false

# Batasi ke satu CP, nama grup, atau group ID (opsional)
TEST_GROUP_ONLY=
